# ============================================
# FOR LOCAL DEVELOPMENT (without Docker)
# ============================================
# Use this if you're running PostgreSQL locally on your machine

# NewsAPI Configuration
NEWS_API_KEY=your_newsapi_key_here

# PostgreSQL Configuration (Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_etl_db
DB_USER=your_system_username
DB_PASSWORD=

# ============================================
# FOR DOCKER DEPLOYMENT
# ============================================
# If using Docker, you ONLY need NEWS_API_KEY above
# (PostgreSQL is managed by docker-compose.yml)
# Just delete the DB_* lines or leave them - they'll be ignored
