# ============================================
# DOCKER DEPLOYMENT - Minimal Configuration
# ============================================
# For Docker, you ONLY need to set your NewsAPI key
# PostgreSQL is automatically configured by docker-compose.yml

# NewsAPI Configuration
NEWS_API_KEY=your_newsapi_key_here

# Note: DB_HOST, DB_USER, DB_PASSWORD are set in docker-compose.yml
# You don't need to configure them here!
